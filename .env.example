# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_APP_TARGET: Controls which deliverable surface is built:
# - "hub" (default web platform with Client App, Driver App, School Portal, Admin, Public Intake, and Demo)
# - "client" (standalone MôBuss Client App for App Store / Google Play via Capacitor)
# - "driver" (standalone MôBuss Driver App for App Store / Google Play via Capacitor)
VITE_APP_TARGET="hub"

# VITE_API_BASE_URL: Leave empty on the web Hub; set to your deployed backend origin
# (e.g. "https://api.mobuss.ao") when building native iOS/Android binaries in VS Code.
VITE_API_BASE_URL=""

# MOBUSS_PIN_PEPPER: Required server-side pepper for salting/hashing 4-digit handover PINs
# Configure via AI Studio Settings -> Secrets or local .env (must differ from MOBUSS_AUTH_SECRET)
MOBUSS_PIN_PEPPER=

# MOBUSS_AUTH_SECRET: Required separate server-side HMAC secret for signing session tokens
# Configure via AI Studio Settings -> Secrets or local .env (must differ from MOBUSS_PIN_PEPPER)
MOBUSS_AUTH_SECRET=
